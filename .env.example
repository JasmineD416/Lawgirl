# Local development: copy to .env.local. Production: /etc/lawgirl/lawgirl.env on the server. Never commit actual values.
# Optional locally; defaults are .data/law-girl.sqlite and .data/files.
DATABASE_PATH=
FILES_DIR=
# The owner signs up like any student with this email, then confirms it from the email link.
OWNER_EMAIL=
SITE_URL=https://www.lawgirl.ca
PUBLIC_INDEXING=false
STRIPE_SECRET_KEY=
# Webhook events: checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded, charge.dispute.created
STRIPE_WEBHOOK_SECRET=
# Optional legacy catalog fallback; preferred book configuration is in Owner Studio.
BOOK_CATALOG={}
RESEND_API_KEY=
MAIL_FROM=
MAIL_POSTAL_ADDRESS=
RESEND_WEBHOOK_SECRET=
NEWSLETTER_DISPATCH_SECRET=
RATE_LIMIT_SECRET=
