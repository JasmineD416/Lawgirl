{
  // Law Girl on Cloudflare Workers. See docs/DEVELOPER_HANDOFF.md → Deployment.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "law-girl",
  "main": "./build/worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "law-girl-db",
      "database_id": "03b8ceb7-5276-4411-9154-206de3a3ffa4",
      "migrations_dir": "drizzle"
    }
  ],
  // File storage for paid e-books and uploaded covers. To turn it on: enable R2 in the
  // Cloudflare dashboard, run `wrangler r2 bucket create law-girl-files`, then add:
  // "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "law-girl-files" }],
  // Keep that bucket private.
  "observability": { "enabled": true }
}
